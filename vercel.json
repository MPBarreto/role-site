{
  "redirects": [
    {
      "source": "/privacidade",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacidade.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/privacy.html",
      "destination": "/privacy",
      "permanent": true
    },
    {
      "source": "/child-safety.html",
      "destination": "/seguranca-infantil",
      "permanent": true
    },
    {
      "source": "/termos",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/termos.html",
      "destination": "/terms",
      "permanent": true
    },
    {
      "source": "/reembolsos.html",
      "destination": "/reembolsos",
      "permanent": true
    },
    {
      "source": "/produtores.html",
      "destination": "/produtores",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/seguranca-infantil",
      "destination": "/child-safety.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/reembolsos",
      "destination": "/reembolsos.html"
    },
    {
      "source": "/produtores",
      "destination": "/produtores.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
