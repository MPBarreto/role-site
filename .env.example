# Public Vite settings. These values are included in the browser bundle.
VITE_APP_STORE_URL=
VITE_GOOGLE_PLAY_URL=
VITE_EVENTS_API_URL=/api/events
VITE_PRODUCER_SIGNUP_URL=
VITE_CONTACT_TOKEN_URL=/api/contact-token
VITE_CONTACT_URL=/api/contact

# WhatsApp contact protection
CONTACT_SECRET=change-this-to-a-long-random-secret
WHATSAPP_NUMBER=5511999999999
WHATSAPP_MESSAGE=Olá! Quero saber como levar o Rolê para minha casa de eventos.
# Set only in production, e.g. site.role.app
SITE_HOST=

# Server-only Supabase credentials used by /api/events.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
VITE_GA4_MEASUREMENT_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
